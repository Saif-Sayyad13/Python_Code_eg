 # wap to check the given character is uppercase, lowercase or digit without using isupper(), islower() and isdigit() methods
# without using inbuilt methods
# its drawback we can pass only one character at a time (single - single character )
x=eval(input("Enter a character: "))
if ord("A")<=ord(x)<=ord("Z"):   #-- 65<=character<=90
    print("The character is uppercase.")
elif ord("a")<=ord(x)<=ord("z"): #-- 97<=character<=122
    print("The character is lowercase.")
elif ord("0")<=ord(x)<=ord("9"): #-- 48<=character<=57
    print("The character is a digit.")
else:
    print("The character is a special character .")
    

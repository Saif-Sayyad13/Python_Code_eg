'''# when we have multiple condition we can use elif block
# in elif condition we can use else block but else block is optional
# In elif condition we can use multiple elif block based on the condition 
# Syntax:
if condition:----True State Block 
    statement
elif condition:-------TSB
    statement
elif condition:--------TSB
    statement
elif condition:---------TSB
    statement
else:-----------------------False State Block------(optional)
    statement

'''
'''
# wap to check the number is positive, negative or zero using elif condition
num = int(input("Enter a number: "))
if num > 0:
    print("The number is positive.")
elif num < 0:
    print("The number is negative.")
else:
    print("The number is zero.")
    
# wap to check the  given character is alphabet, digit or special character using elif condition
char = input("Enter a character: ")
if char.isalpha():
    print("The character is an alphabet.")
elif char.isdigit():
    print("The character is a digit.")
else:
    print("The character is a special character.")
 '''
